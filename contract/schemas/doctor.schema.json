{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-native-cli-spec:doctor:2.0",
  "title": "doctor",
  "description": "The data of doctor (CLI-036): checks, each with status pass, warn or fail, a message and a fix: null when the check passes, an actionable sentence when it fails. The required checks are credentials, connectivity, state_store, authorization and version; a network failure fails only connectivity. check-contract.py checks that check names are unique.",
  "type": "object",
  "properties": {
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"},
      "allOf": [
        {"contains": {"required": ["check"], "properties": {"check": {"const": "credentials"}}}},
        {"contains": {"required": ["check"], "properties": {"check": {"const": "connectivity"}}}},
        {"contains": {"required": ["check"], "properties": {"check": {"const": "state_store"}}}},
        {"contains": {"required": ["check"], "properties": {"check": {"const": "authorization"}}}},
        {"contains": {"required": ["check"], "properties": {"check": {"const": "version"}}}}
      ]
    }
  },
  "required": ["checks"],
  "additionalProperties": false,
  "$defs": {
    "check": {
      "type": "object",
      "properties": {
        "check": {"$ref": "urn:ai-native-cli-spec:common:2.0#/$defs/name"},
        "status": {"enum": ["pass", "warn", "fail"]},
        "message": {"$ref": "urn:ai-native-cli-spec:common:2.0#/$defs/text"},
        "fix": {"type": ["string", "null"], "minLength": 1}
      },
      "required": ["check", "status", "message", "fix"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "pass"}}},
          "then": {"properties": {"fix": {"type": "null"}}}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "fail"}}},
          "then": {"properties": {"fix": {"type": "string"}}}
        }
      ]
    }
  }
}
